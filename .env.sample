# Copy to .env. Never commit a real key. Restart the server after changing settings.
# Meta Responses configuration from the supplied developer tutorial.
LLM_API=responses
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=
LLM_MODEL=muse-wonder-1.0
# For another OpenAI-compatible provider, use its URL/model and choose
# LLM_API=chat_completions or responses according to its documentation.

# Optional image model. Endpoint/key/protocol inherit LLM_* unless overridden.
# Only set a model your provider confirms accepts images.
# VISION_MODEL=
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_API=responses
PAPER_MAX_READ_FIGURES=12
PAPER_MAX_SCANNED_PAGES=20
LLM_MAX_TOKENS=16000
LLM_TIMEOUT=600
PAPER_MAX_CHARS=120000
PAPER_MAX_UPLOAD_MB=50

# auto/landlock require Linux 6.7+ x86_64 with Landlock and seccomp.
# guard is for trusted local development and is refused in production mode.
PAPER_SANDBOX=auto
PAPER_MAX_WORKERS=2
# Total active and queued builds. Admission is rejected before saving a new run.
PAPER_MAX_PENDING_RUNS=10
PAPER_MAX_TUTOR_REQUESTS=2
PAPER_RUNS_DIR=runs
PAPER_RUN_RETENTION_DAYS=7

# scripts/start.sh enables production mode and private browser sessions automatically.
# Optional extra entry gate; if set, use at least 32 random characters.
# Runs remain private to each session even behind the shared entry gate.
PAPER_ENV=development
PAPER_ACCESS_TOKEN=
PAPER_RATE_LIMIT_PER_HOUR=20

# Persisted conservative token reservations; failed requests also consume their reservation.
PAPER_DAILY_USER_TOKENS=5000000
PAPER_DAILY_GLOBAL_TOKENS=20000000
PAPER_RUN_TOKEN_LIMIT=3000000
PAPER_RUN_CALL_LIMIT=100
PAPER_WORKER_MEMORY_MB=3072
PAPER_WORKER_CPU_SECONDS=600
PAPER_WORKER_WALL_SECONDS=3600

# Admission ceiling; active builds can still grow. Service/disk monitoring remains necessary.
PAPER_MAX_STORAGE_MB=2048
