[Unit]
Description=Paper-to-World
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paper-world
Group=paper-world
WorkingDirectory=/opt/paper-to-world
Environment=PAPER_ENV=production
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/paper-to-world/browsers
EnvironmentFile=/opt/paper-to-world/.env
ExecStart=/usr/bin/env PAPER_ENV=production /opt/paper-to-world/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --no-server-header --limit-concurrency 64 --backlog 128
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/paper-to-world/runs
UMask=0077
MemoryMax=2500M
MemorySwapMax=0
CPUQuota=200%
TasksMax=256
LimitNOFILE=4096
LimitFSIZE=128M

[Install]
WantedBy=multi-user.target
